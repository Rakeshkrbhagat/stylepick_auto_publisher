# Copy to .env for local use. Never commit real credentials.
# On Render set these as Environment Variables; upload the OAuth JSON as a Secret File.

APP_NAME=ReelFlow Studio

# Google OAuth client JSON (read-only Drive access).
#  Local:  "Desktop app" client saved at credentials/client_secret.json
#  Render: "Web application" client uploaded as Secret File -> /etc/secrets/client_secret.json
GOOGLE_CLIENT_SECRETS_FILE=credentials/client_secret.json

# Hosted only: the app's public URL, also listed as an Authorized redirect URI in Google Cloud.
# e.g. https://your-app.onrender.com/   (leave empty locally)
GOOGLE_OAUTH_REDIRECT_URI=

# Optional
DEFAULT_TIMEZONE=Asia/Kolkata
WORK_DIR=/tmp/reelflow_downloads

# No database, Meta/Facebook/Instagram credentials or token-encryption keys are needed.

