# Copy this file to .env for local configuration.
# Do not commit real credentials to source control.

APP_NAME=StylePick Finds Auto Publisher

# Google Drive (OAuth "Desktop app" client JSON downloaded from Google Cloud Console).
# Keep this file outside source control (credentials/ is git-ignored).
GOOGLE_CLIENT_SECRETS_FILE=credentials/client_secret.json
# Temporary working directory for downloaded videos and retention (hours).
WORK_DIR=data/downloads
DOWNLOAD_RETENTION_HOURS=24

# Meta app (Facebook Page + Instagram publishing) – developers.facebook.com → app → Settings → Basic
META_APP_ID=
META_APP_SECRET=
# Verify the current Graph API version before use.
META_GRAPH_VERSION=v23.0
# Must match a Valid OAuth Redirect URI in the app: http://localhost:8765/
META_REDIRECT_PORT=8765
JOB_DB_PATH=data/publishing.db
# Max seconds to wait for Facebook/Instagram video processing per post
FB_POLL_TIMEOUT_SECONDS=300

# Optional live tests
# Facebook (creates a DRAFT reel, never public):
# META_TEST_PAGE_ID=
# META_TEST_PAGE_TOKEN=
# META_TEST_VIDEO=path/to/vertical_test.mp4
# Instagram (creates a PUBLIC reel – use a test account):
# META_TEST_IG_USER_ID=
# META_TEST_IG_TOKEN=
# META_TEST_IG_PUBLISH=1

